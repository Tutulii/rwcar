VITE_PRIVY_APP_ID=your_privy_app_id
VITE_API_URL=http://127.0.0.1:3001
# Public, reviewed release metadata emitted by deploy-v2-uat.mjs. Keep blank
# before deployment. The browser rejects API V2 addresses/code that do not
# exactly match this build-time manifest.
VITE_TRUSTED_V2_MANIFEST_JSON=

# Backend only. Never expose these through VITE_* variables.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://rwcar:rwcar@127.0.0.1:5432/rwcar
# auto disables TLS for localhost and Railway private networking, and verifies
# certificates for public hosts. Railway services should set disable explicitly.
DATABASE_SSL_MODE=auto
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
REPO_MARKET_ADDRESS=0x90535a7176a3b2c251c834b28e11e245622ee808
ASSET_REGISTRY_ADDRESS=0x38a859695c32eea74b51c0f098039e15e616d5d6
REPO_MARKET_DEPLOYMENT_BLOCK=51054911

# V2 API contract map. Leave blank until the V2 activation manifest is reviewed.
REPO_MARKET_V2_ADDRESS=
PROTOCOL_MODULE_FACTORY_V2_ADDRESS=
COLLATERAL_VAULT_V2_ADDRESS=
SETTLEMENT_ESCROW_V2_ADDRESS=
DUTCH_AUCTION_V2_ADDRESS=
MARGIN_ENGINE_V2_ADDRESS=
VALUATION_ORACLE_V2_ADDRESS=
RISK_MANAGER_V2_ADDRESS=
FEE_TREASURY_ADDRESS=
V2_SETTLEMENT_TOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
AUSDC_CLEANVERSE_REQUEST_ID=
V2_QUOTE_TTL_SECONDS=30
# Seconds; must exactly match the immutable constructor list.
V2_ALLOWED_DURATIONS=300,604800,1209600,2592000
# Fail closed until the margin engine passes its separate activation matrix.
V2_MARGIN_ENABLED=false
# Operator attestations are additional fail-closed API gates. Change each one only
# after its request IDs, transaction hashes, rules, and smoke proof are in the manifest.
V2_REPO_POLICY_POOL_REGISTERED=false
V2_FEE_TREASURY_AUSDC_ELIGIBLE=false
V2_SETTLEMENT_ESCROW_AUSDC_READY=false
V2_MARGIN_POLICY_POOL_REGISTERED=false
V2_MARGIN_VAULT_CUSTODY_READY=false
V2_MARGIN_ESCROW_AUSDC_READY=false
V2_MARGIN_TREASURY_AUSDC_ELIGIBLE=false

INDEXER_CONFIRMATIONS=3
INDEXER_BATCH_SIZE=100
INDEXER_POLL_MS=5000
INDEXER_CATCHUP_DELAY_MS=100
V1_INDEXER_ENABLED=true
V1_KEEPER_ENABLED=true
# Dedicated gas-funded testnet signer. V1 and V2 lifecycle calls are permissionless;
# this key has no protocol owner or custody role.
KEEPER_PRIVATE_KEY=
KEEPER_POLL_MS=10000
# Keeps permissionless automation near finalized projections without requiring
# equality with a continuously moving high-throughput chain head.
V2_AUTOMATION_MAX_CHECKPOINT_LAG=100
# JSON array copied from the reviewed V2 deployment manifest. Keep [] before deployment.
V2_DEPLOYMENTS_JSON=[]
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
# Privy server signer and deny-by-default policy identifiers. These identifiers
# are public metadata; authorization private keys belong only on agent-executor.
PRIVY_AGENT_SIGNER_ID=
PRIVY_AGENT_POLICY_ID=
ADMIN_API_KEY=
VALUATION_SIGNERS=
COMPLIANCE_CACHE_SECONDS=30

# Institution agent platform. Keep disabled until the API, executor, Privy
# policy, and approved skill manifest are configured together.
AGENT_PLATFORM_ENABLED=false
AGENT_ISSUER_URL=http://127.0.0.1:3001
AGENT_AUDIENCE=http://127.0.0.1:3001/mcp
AGENT_JWT_PRIVATE_JWK=
AGENT_JWT_KEY_ID=rwcar-agent-es256-v1
AGENT_TOKEN_TTL_SECONDS=300
AGENT_CREDENTIAL_TTL_DAYS=30
AGENT_INTENT_TTL_SECONDS=300
AGENT_EXECUTOR_LEASE_TIMEOUT_SECONDS=600
AGENT_EXECUTOR_API_KEY=
AGENT_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
AGENT_ALLOWED_MANIFEST_HASHES=0x87d6fc93172bf027219cd6de1f20eb29004dbddee9e235f3fa76b9803796877f
# Cleanverse synthetic KYC is strictly an opt-in UAT onboarding helper.
AGENT_UAT_SYNTHETIC_CVI_ENABLED=false

# Public build-time identifiers used only when creating a dedicated Privy
# agent wallet from the authenticated Agent Console.
VITE_PRIVY_AGENT_SIGNER_ID=
VITE_PRIVY_AGENT_POLICY_ID=

# Agent executor only. Never configure this on the web or API services.
AGENT_API_BASE_URL=http://127.0.0.1:3001
EXECUTOR_WORKER_ID=rwcar-agent-executor-local
AGENT_EXECUTOR_POLL_MS=2000
PRIVY_AGENT_AUTHORIZATION_PRIVATE_KEYS=

# Private S3-compatible evidence storage.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=rwcar-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# V1 one-time UAT deployment shell only. Do not configure these on the API/indexer.
UAT_DEPLOYER_PRIVATE_KEY=
UAT_OWNER_ADDRESS=
CVA_ASSET_ADDRESS=0x7A33e03B10268FFdB50e562721B092BC0Cb793F9
CVA_REFERENCE_HASH=
SETTLEMENT_TOKEN_ADDRESS=0xaC0893567D43C3E7e6e35a72803df05416C1f20D
COMPLIANCE_VALIDATOR_ADDRESS=0xaC7e5179C2C7f03f209136886c172eb34F161792

# V2 one-time UAT deployment shell. The script is plan-only unless all execution
# interlocks are deliberately supplied. Never put V2_UAT_DEPLOYER_PRIVATE_KEY on a server.
V2_DEPLOY_MODE=plan
V2_SOURCE_REVISION=
V2_DEPLOYER_ADDRESS=
V2_OWNER_ADDRESS=
# Fresh EOA used only to sign the Cleanverse factory grant and execute the four
# constrained custody registrations, then transfer factory ownership to V2_OWNER_ADDRESS.
V2_FACTORY_ACTIVATION_OWNER=
V2_PAUSE_GUARDIAN_ADDRESS=
V2_ORACLE_SIGNER_1=
V2_ORACLE_SIGNER_2=
V2_ORACLE_SIGNER_3=
V2_UAT_DEPLOYER_PRIVATE_KEY=
V2_DEPLOY_CONFIRM=
V2_KEY_ROTATION_ATTESTATION=
V2_ALLOW_EOA_OWNER=false
V2_ALLOW_ROLE_OVERLAP=false
V2_DEPLOY_CONFIRMATIONS=3
CVA_ASSET_DECIMALS=6
V2_PROTOCOL_FEE_BPS=15
V2_GRACE_PERIOD_SECONDS=120
V2_RISK_CONFIG_DELAY_SECONDS=86400

# Delayed per-CVA risk configuration. Values are examples for UAT review, not
# investment advice or automatically approved production limits.
V2_INITIAL_LTV_BPS=7000
V2_MAINTENANCE_LTV_BPS=8000
V2_LIQUIDATION_LTV_BPS=8500
V2_AUCTION_START_BPS=10500
V2_AUCTION_FLOOR_BPS=8000
V2_LIQUIDATION_FEE_BPS=50
V2_EARLY_MIN_HOLD_BPS=1000
V2_EARLY_BREAK_FEE_BPS=25
V2_DEFAULT_SPREAD_BPS=500
V2_MAX_DEFAULT_RATE_BPS=5000
V2_MAX_ORACLE_AGE_SECONDS=3600
V2_AUCTION_DURATION_SECONDS=1800
V2_MARGIN_CALL_PERIOD_SECONDS=3600
V2_STALE_ORACLE_FALLBACK_DELAY_SECONDS=86400
