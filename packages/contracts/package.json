{
  "name": "@rwcar/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/compile.mjs",
    "build:hardhat": "hardhat compile --build-profile production",
    "test": "npm run build && node --test test/*.test.mjs",
    "deploy:uat": "npm run build && node scripts/deploy-uat.mjs",
    "deploy:uat:v2": "npm run build && node scripts/deploy-v2-uat.mjs",
    "deploy:uat:v2:secure": "npm run build && node scripts/run-v2-uat-deployment.mjs",
    "activate:cleanverse:v2": "node scripts/activate-v2-cleanverse-uat.mjs",
    "onboard:fee-treasury:v2": "node scripts/onboard-v2-fee-treasury-uat.mjs",
    "fund:roles:v2": "node scripts/fund-v2-uat-roles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.4",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.5",
    "ganache": "^7.9.2",
    "hardhat": "^3.12.0",
    "solc": "0.8.24",
    "typescript": "^5.9.3",
    "viem": "^2.55.11"
  }
}
