{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.indexer",
    "watchPatterns": [
      "/apps/indexer/**",
      "/packages/db/**",
      "/packages/shared/**",
      "/deploy/railway/indexer.railway.json",
      "/Dockerfile.indexer",
      "/package.json",
      "/package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/indexer/dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
