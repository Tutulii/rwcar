{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.agent-executor",
    "watchPatterns": [
      "/apps/agent-executor/**",
      "/packages/shared/**",
      "/deploy/railway/agent-executor.railway.json",
      "/Dockerfile.agent-executor",
      "/package.json",
      "/package-lock.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/agent-executor/dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
